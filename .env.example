# No data API key is required. Candles are requested through TradingView's
# unofficial WebSocket protocol for OANDA:XAUUSD.
PORT=3002

# Login is always required. Use HTTPS for a hosted dashboard.
# This must exactly match the address users open (including localhost vs 127.0.0.1).
AUTH_PUBLIC_URL=http://127.0.0.1:3002
# Google OAuth Web application callback: AUTH_PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend API key and an address on your verified sending domain.
# Verification emails and reset links are never logged or returned by the API.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional server-only AI reviewer. Never expose this key in browser code.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:1.7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional Telegram alerts for new live chart entries and their SL/TP results.
# Keep these values only in the local .env file. Start a chat with the bot first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional MT5 bridge authentication. Put the same random secret in .env.mt5.
MT5_BRIDGE_TOKEN=replace-with-a-long-random-secret
