# Dashboard connection. Match the port printed by npm run dev.
DASHBOARD_URL=http://127.0.0.1:3002

# Use the same long random value in the dashboard .env as MT5_BRIDGE_TOKEN.
MT5_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Optional: leave login fields empty to use the account already signed into MT5.
MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

MT5_MAGIC_NUMBER=998877
MT5_POLL_SECONDS=1

# This second safety lock must be YES before real/demo orders are sent.
# Keep NO while testing dashboard Dry Run mode.
MT5_ALLOW_LIVE_EXECUTION=NO
